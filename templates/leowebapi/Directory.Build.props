<Project>
    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <Nullable>enable</Nullable>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <EnableNETAnalyzers>true</EnableNETAnalyzers>
        <AnalysisLevel>latest</AnalysisLevel>
        <NuGetAudit>true</NuGetAudit>
        <ImplicitUsings>enable</ImplicitUsings>
        <!-- Runtime async: async methods are suspended/resumed by the runtime instead of compiler-generated
             state machines. Without the state machine overhead there is no reason to prefer ValueTask, so
             we use Task unless an external API (e.g. IAsyncDisposable) requires ValueTask. -->
        <Features>$(Features);runtime-async=on</Features>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="NodaTime" Version="3.3.7"/>
        <PackageReference Include="HTLLeonding.Utility.LeoAnalyzers" Version="1.3.0"/>
    </ItemGroup>
    <ItemGroup>
        <Using Include="NodaTime"/>
        <Using Include="Microsoft.Extensions.Logging"/>
    </ItemGroup>
</Project>